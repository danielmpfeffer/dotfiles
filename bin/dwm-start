#!/bin/sh
# dwm autostart — translated from your i3 config's exec/exec_always lines.
# dwm has no built-in autostart, so this script launches everything, then
# execs dwm itself.

# The display manager doesn't read ~/.profile, so add the personal bin dirs
# here — dwm and everything it launches inherit this (clipmenu needs
# ~/.local/bin to find clipserve, and dmenu-recent lists what's on PATH).
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Load X resources (xterm colors, etc.) — fast, nothing else depends on
# timing here, so it runs first and unbackgrounded rather than with a &
# like everything below.
xrdb -merge ~/.Xresources

# XDG autostart .desktop files (matches: exec dex --autostart --environment i3)
dex --autostart --environment dwm &

# Screen locking on suspend (matches: exec xss-lock ...)
# slock blocks in the foreground natively, no --nofork-equivalent flag needed.
xss-lock --transfer-sleep-lock -- slock &

# Network tray icon — NOTE: needs the systray patch on dwm to actually be
# visible. It'll still run and manage your connection either way.
nm-applet &

# Multi-monitor setup (matches: exec monitor-setup.sh)
~/.local/bin/monitor-setup.sh &

# Compositor (matches: exec picom -b)
picom -b &


# Wallpaper — Debian 13's actual default ("Ceratopsian" theme), converted
# from the package's SVG to a personal PNG copy so feh doesn't depend on
# its SVG loader plugin being present.
feh --bg-fill ~/Pictures/debian13-wallpaper.png &

# Notifications (matches: exec dunst)
dunst &

# Clipboard history daemon — Super+v (clipmenu) shows what it has saved.
~/.local/bin/clipmenud &

# Volume tray icon — same systray caveat as nm-applet above.
pasystray &

# Permanent night light default (matches: exec xsct 3500)
xsct 3500 &

# Turn the system bell off (matches: exec xset b off)
xset b off &

# Status bar text — slstatus sets the root window name itself, no piping needed.
slstatus &

exec dwm
